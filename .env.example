# =============================================================================
# PaperVault local environment template
# -----------------------------------------------------------------------------
# Usage:
#   1) Copy this file to .env (already git-ignored) and fill in real values.
#   2) Load it into your shell before running python / node commands:
#
#      Git Bash / WSL:
#          set -a; source .env; set +a
#
#      PowerShell:
#          Get-Content .env | ForEach-Object {
#              if ($_ -match '^\s*([^#][^=]*?)\s*=\s*(.*)\s*$') {
#                  [System.Environment]::SetEnvironmentVariable($Matches[1], $Matches[2])
#              }
#          }
#
#      Conda (one-shot):
#          conda env config vars set HF_TOKEN=... PAPERVAULT_HF_REPO_ID=...
#          conda activate llm   # re-activate so the vars take effect
#
# DO NOT commit .env to git.  Only this .env.example is tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# Hugging Face (REQUIRED for cache.jsonl.gz read/write)
# -----------------------------------------------------------------------------
# Personal access token with WRITE permission on the dataset repo below.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The dataset repo that holds the authoritative cache.jsonl.gz.
# Format: "<namespace>/<repo-name>"  e.g. "youngfish42/papervault-cache"
PAPERVAULT_HF_REPO_ID=youngfish42/papervault-cache

# Optional: repo kind. Default is "dataset"; use "model" or "space" only if
# you intentionally host the cache on a non-dataset repo.
# PAPERVAULT_HF_REPO_TYPE=dataset

# Optional: upload retry tuning (defaults: 5 attempts, 2.0 s base backoff)
# PAPERVAULT_HF_UPLOAD_MAX_ATTEMPTS=5
# PAPERVAULT_HF_UPLOAD_RETRY_BACKOFF=2.0

# Optional: set to 1 to skip every HF refresh / upload and operate purely on
# the local cache copy. Useful for air-gapped dev or when HF is unreachable.
# PAPERVAULT_OFFLINE=0

# -----------------------------------------------------------------------------
# Scraping / discovery
# -----------------------------------------------------------------------------
# Email injected into the User-Agent header for polite scraping
# (Crossref/OpenAlex etc. rate-limit anonymous traffic more aggressively).
CONTACT_EMAIL=im.young@foxmail.com

# -----------------------------------------------------------------------------
# OpenAI ("Guess You Like" keyword suggestion feature in the web UI)
# -----------------------------------------------------------------------------
# Leave blank if you don't need the AI suggestion feature.
OPENAI_API_KEY=
# Optional: custom base URL (e.g. for Azure OpenAI or a proxy).
# OPENAI_API_BASE=https://api.openai.com/v1
